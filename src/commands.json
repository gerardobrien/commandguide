[
  { "group": "Files", "items": [
    { "task": "Find files by name", "cmd": "find . -name \"*.log\"" },
    { "task": "See what is using disk space", "cmd": "du -sh * | sort -h" },
    { "task": "Check free disk space", "cmd": "df -h" },
    { "task": "Compress a folder", "cmd": "tar -czf backup.tar.gz folder/" },
    { "task": "Extract a .tar.gz archive", "cmd": "tar -xzf backup.tar.gz" },
    { "task": "Follow a log file as it grows", "cmd": "tail -f app.log" }
  ]},
  { "group": "Text", "items": [
    { "task": "Search for text in a folder", "cmd": "grep -rn \"error\" ." },
    { "task": "Replace text in a file", "cmd": "sed -i 's/old/new/g' file.txt" },
    { "task": "Count lines in a file", "cmd": "wc -l file.txt" }
  ]},
  { "group": "Git", "items": [
    { "task": "See what has changed", "cmd": "git status" },
    { "task": "Create a branch and switch to it", "cmd": "git switch -c my-branch" },
    { "task": "Save staged changes as a commit", "cmd": "git commit -m \"Describe the change\"" },
    { "task": "Push a new branch to GitHub", "cmd": "git push -u origin my-branch" },
    { "task": "Unstage a file but keep the edits", "cmd": "git restore --staged file.txt" },
    { "task": "Undo the last commit but keep the changes", "cmd": "git reset --soft HEAD~1" },
    { "task": "View history as a compact graph", "cmd": "git log --oneline --graph" }
  ]},
  { "group": "Network", "items": [
    { "task": "List listening ports", "cmd": "ss -tulpn" },
    { "task": "Look up a domain's IP address", "cmd": "dig +short example.com" },
    { "task": "See only the response headers from a site", "cmd": "curl -I https://example.com" },
    { "task": "Test whether a port is open", "cmd": "nc -zv example.com 443" },
    { "task": "Show this machine's IP addresses", "cmd": "ip -br addr" }
  ]},
  { "group": "SSH", "items": [
    { "task": "Create a new SSH key", "cmd": "ssh-keygen -t ed25519 -C \"label\"" },
    { "task": "Connect on a custom port", "cmd": "ssh -p 2222 user@host" },
    { "task": "Copy your key to a server", "cmd": "ssh-copy-id user@host" },
    { "task": "Sync a folder to a server", "cmd": "rsync -avz dist/ user@host:/var/www/site/" }
  ]},
  { "group": "Processes", "items": [
    { "task": "Find a process by name", "cmd": "pgrep -a nginx" },
    { "task": "Stop a process by ID", "cmd": "kill 1234" },
    { "task": "Check a service's status", "cmd": "systemctl status nginx" },
    { "task": "Read a service's recent logs", "cmd": "journalctl -u nginx -n 50" }
  ]},
  { "group": "Docker", "items": [
    { "task": "List running containers", "cmd": "docker ps" },
    { "task": "Follow a container's logs", "cmd": "docker logs -f my-container" },
    { "task": "Open a shell inside a container", "cmd": "docker exec -it my-container sh" },
    { "task": "Start a Compose stack in the background", "cmd": "docker compose up -d" }
  ]}
]
