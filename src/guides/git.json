{
  "slug": "git",
  "title": "Git commands",
  "description": "Git commands for branches, commits, pushing changes, undoing mistakes and viewing history.",
  "tone": "coral",
  "groups": [
    {
      "group": "Git",
      "items": [
        {
          "task": "See what has changed",
          "cmd": "git status",
          "platforms": [
            "linux",
            "macos",
            "windows"
          ]
        },
        {
          "task": "Create a branch and switch to it",
          "cmd": "git switch -c my-branch",
          "platforms": [
            "linux",
            "macos",
            "windows"
          ]
        },
        {
          "task": "Save staged changes as a commit",
          "cmd": "git commit -m \"Describe the change\"",
          "platforms": [
            "linux",
            "macos",
            "windows"
          ]
        },
        {
          "task": "Push a new branch to GitHub",
          "cmd": "git push -u origin my-branch",
          "platforms": [
            "linux",
            "macos",
            "windows"
          ]
        },
        {
          "task": "Unstage a file but keep the edits",
          "cmd": "git restore --staged file.txt",
          "platforms": [
            "linux",
            "macos",
            "windows"
          ]
        },
        {
          "task": "Undo the last commit but keep the changes",
          "cmd": "git reset --soft HEAD~1",
          "platforms": [
            "linux",
            "macos",
            "windows"
          ]
        },
        {
          "task": "View history as a compact graph",
          "cmd": "git log --oneline --graph",
          "platforms": [
            "linux",
            "macos",
            "windows"
          ]
        }
      ]
    }
  ]
}
