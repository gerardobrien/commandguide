            "macos"
          ]
        },
        {
          "task": "Find the biggest folders on the system",
          "cmd": "sudo du -h -d 1 / 2>/dev/null | sort -h",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "List disks and partitions",
          "cmd": "lsblk",
          "platforms": [
            "linux"
          ]
        },
        {
          "task": "Show disk IDs and filesystem types",
          "cmd": "sudo blkid",
          "platforms": [
            "linux"
          ]
        },
        {
          "task": "Mount a partition",
          "cmd": "sudo mount /dev/sdb1 /mnt/data",
          "platforms": [
            "linux"
          ]
        },
        {
          "task": "Unmount a partition",
          "cmd": "sudo umount /mnt/data",
          "platforms": [
            "linux"
          ]
        },
        {
          "task": "List mounted filesystems",
          "cmd": "findmnt",
          "platforms": [
            "linux"
          ]
        },
        {
          "task": "Format a partition as ext4",
          "cmd": "sudo mkfs.ext4 /dev/sdb1",
          "platforms": [
            "linux"
          ],
          "warning": "Erases everything on the partition. Check the device name with lsblk first."
        }
      ]
    },
    {
      "group": "Network",
      "items": [
        {
          "task": "Show this machine's IP addresses",
          "cmd": "ip -br addr",
          "platforms": [
            "linux"
          ]
        },
        {
          "task": "Show the routing table",
          "cmd": "ip route",
          "platforms": [
            "linux"
          ]
        },
        {
          "task": "List listening ports",
          "cmd": "sudo ss -tulpn",
          "platforms": [
            "linux"
          ]
        },
        {
          "task": "Check whether a host is reachable",
          "cmd": "ping -c 4 example.com",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Trace the route to a host",
          "cmd": "traceroute example.com",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Look up a domain's IP address",
          "cmd": "dig +short example.com",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Look up a domain's mail servers",
          "cmd": "dig +short MX example.com",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Show the DNS resolver settings",
          "cmd": "cat /etc/resolv.conf",
          "platforms": [
            "linux"
          ]
        },
        {
          "task": "See only the response headers from a site",
          "cmd": "curl -I https://example.com",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Download a file",
          "cmd": "curl -LO https://example.com/file.tar.gz",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Test whether a port is open",
          "cmd": "nc -zv example.com 443",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Show your public IP address",
          "cmd": "curl -s https://ifconfig.me",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Show network connections",
          "cmd": "nmcli connection show",
          "platforms": [
            "linux"
          ],
          "distros": [
            "redhat"
          ]
        },
        {
          "task": "Restart networking",
          "cmd": "rc-service networking restart",
          "platforms": [
            "linux"
          ],
          "distros": [
            "alpine"
          ]
        }
      ]
    },
    {
      "group": "Firewall",
      "items": [
        {
          "task": "Show the firewall rules",
          "cmd": "sudo ufw status verbose",
          "platforms": [
            "linux"
          ],
          "distros": [
            "debian"
          ]
        },
        {
          "task": "Show the firewall rules",
          "cmd": "sudo firewall-cmd --list-all",
          "platforms": [
            "linux"
          ],
          "distros": [
            "redhat"
          ]
        },
        {
          "task": "Allow SSH through the firewall",
          "cmd": "sudo ufw allow OpenSSH",
          "platforms": [
            "linux"
          ],
          "distros": [
            "debian"
          ]
        },
        {
          "task": "Allow SSH through the firewall",
          "cmd": "sudo firewall-cmd --permanent --add-service=ssh && sudo firewall-cmd --reload",
          "platforms": [
            "linux"
          ],
          "distros": [
            "redhat"
          ]
        },
        {
          "task": "Allow a port",
          "cmd": "sudo ufw allow 443/tcp",
          "platforms": [
            "linux"
          ],
          "distros": [
            "debian"
          ]
        },
        {
          "task": "Allow a port",
          "cmd": "sudo firewall-cmd --permanent --add-port=443/tcp && sudo firewall-cmd --reload",
          "platforms": [
            "linux"
          ],
          "distros": [
            "redhat"
          ]
        },
        {
          "task": "Remove a port rule",
          "cmd": "sudo ufw delete allow 443/tcp",
          "platforms": [
            "linux"
          ],
          "distros": [
            "debian"
          ]
        },
        {
          "task": "Remove a port rule",
          "cmd": "sudo firewall-cmd --permanent --remove-port=443/tcp && sudo firewall-cmd --reload",
          "platforms": [
            "linux"
          ],
          "distros": [
            "redhat"
          ]
        },
        {
          "task": "Turn on the firewall",
          "cmd": "sudo ufw enable",
          "platforms": [
            "linux"
          ],
          "distros": [
            "debian"
          ],
          "warning": "Allow SSH first if you're connected remotely, or you'll lock yourself out."
        },
        {
          "task": "Turn on the firewall",
          "cmd": "sudo systemctl enable --now firewalld",
          "platforms": [
            "linux"
          ],
          "distros": [
            "redhat"
          ]
        }
      ]
    },
    {
      "group": "SSH",
      "items": [
        {
          "task": "Connect to a server",
          "cmd": "ssh user@host",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Connect on a custom port",
          "cmd": "ssh -p 2222 user@host",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Run one command on a server",
          "cmd": "ssh user@host 'uptime'",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Create a new SSH key",
          "cmd": "ssh-keygen -t ed25519 -C \"label\"",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Copy your key to a server",
          "cmd": "ssh-copy-id user@host",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Copy a file to a server",
          "cmd": "scp file.txt user@host:/tmp/",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Copy a file from a server",
          "cmd": "scp user@host:/var/log/app.log .",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Sync a folder to a server",
          "cmd": "rsync -avz dist/ user@host:/var/www/site/",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Reach a server's port through SSH",
          "cmd": "ssh -L 8080:localhost:80 user@host",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Check the SSH server config for errors",
          "cmd": "sudo sshd -t",
          "platforms": [
            "linux"
          ]
        },
        {
          "task": "Restart the SSH server",
          "cmd": "sudo systemctl restart ssh",
          "platforms": [
            "linux"
          ],
          "distros": [
            "debian"
          ]
        },
        {
          "task": "Restart the SSH server",
          "cmd": "sudo systemctl restart sshd",
          "platforms": [
            "linux"
          ],
          "distros": [
            "redhat"
          ]
        },
        {
          "task": "Restart the SSH server",
          "cmd": "rc-service sshd restart",
          "platforms": [
            "linux"
          ],
          "distros": [
            "alpine"
          ]
        }
      ]
    },
    {
      "group": "Archives",
      "items": [
        {
          "task": "Compress a folder",
          "cmd": "tar -czf backup.tar.gz folder/",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Extract a .tar.gz archive",
          "cmd": "tar -xzf backup.tar.gz",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Extract a .tar.gz archive into a folder",
          "cmd": "tar -xzf backup.tar.gz -C /path/to/folder",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "List what is inside a .tar.gz archive",
          "cmd": "tar -tzf backup.tar.gz",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Create a zip file",
          "cmd": "zip -r archive.zip folder/",
          "platforms": [
            "linux",
            "macos"
          ]
        },
        {
          "task": "Extract a zip file",
          "cmd": "unzip archive.zip",
          "platforms": [
            "linux",
            "macos"
          ]
        }
      ]
